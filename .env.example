# Copy to .env.local for local dev. Set real values in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# ESPN private fantasy league cookies (from a logged-in espn.com browser session). Required for the
# last-place payer; without them /api/espn?path=ffl returns 401.
ESPN_S2=your-espn_s2-cookie-value
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}

# Optional. Defaults to the league in league-lore.json (182263).
ESPN_LEAGUE_ID=000000

# Optional. pages/api/pick.js (server) and lib/clients.mjs (browser, NEXT_PUBLIC_*) fall back to the project's publishable URL/key when unset.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Server-only. Required for pick writes and for storing Web Push subscriptions.
# Never expose this to the browser and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push. Generate a pair with: npx web-push generate-vapid-keys
# Put the public key in VAPID_PUBLIC_KEY (the app reads it from /api/push; it is public by design).
# VAPID_PRIVATE_KEY stays on the server. VAPID_SUBJECT is a mailto: or https: contact.
# Set the same values on Preview if you want alerts on the preview deploy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/push?job=missing.
# The open app can also wake a sweep without this secret; alerts are still deduped.
# PUSH_CRON_SECRET is accepted as an alias of CRON_SECRET by /api/health's report only.
CRON_SECRET=
